# Include from the Lead-owned entry CMakeLists.txt AFTER add_library(s3c ...):
# include("${CMAKE_CURRENT_SOURCE_DIR}/audio/S5Audio.cmake")
# s5_add_advanced_audio(s3c)
# Also call InitAdvancedAudio(env, exports) once in module Init.
include_guard(GLOBAL)
set(S5_AUDIO_CPP_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
function(s5_add_audio_core)
  if(TARGET s5_audio_core)
    return()
  endif()
  set(OPUS_BUILD_SHARED_LIBRARY OFF CACHE BOOL "" FORCE)
  set(BUILD_SHARED_LIBS OFF)
  set(OPUS_BUILD_TESTING OFF CACHE BOOL "" FORCE)
  set(BUILD_TESTING OFF)
  set(OPUS_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
  set(OPUS_CUSTOM_MODES OFF CACHE BOOL "" FORCE)
  set(OPUS_DISABLE_INTRINSICS ON CACHE BOOL "Portable C, no target assembly" FORCE)
  set(OPUS_DRED OFF CACHE BOOL "" FORCE)
  set(OPUS_OSCE OFF CACHE BOOL "" FORCE)
  set(OPUS_INSTALL_PKG_CONFIG_MODULE OFF CACHE BOOL "" FORCE)
  set(OPUS_INSTALL_CMAKE_CONFIG_MODULE OFF CACHE BOOL "" FORCE)
  add_subdirectory("${S5_AUDIO_CPP_DIR}/vendor/opus/opus-1.5.2" "${CMAKE_CURRENT_BINARY_DIR}/s5-opus")
  set_target_properties(opus PROPERTIES POSITION_INDEPENDENT_CODE ON)
  add_library(s5_audio_core STATIC "${S5_AUDIO_CPP_DIR}/audio_core.cpp")
  set_target_properties(s5_audio_core PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON)
  target_include_directories(s5_audio_core PUBLIC "${S5_AUDIO_CPP_DIR}")
  target_link_libraries(s5_audio_core PUBLIC Opus::opus)
endfunction()
function(s5_add_advanced_audio target)
  s5_add_audio_core()
  target_sources(${target} PRIVATE "${S5_AUDIO_CPP_DIR}/native_audio.cpp")
  target_include_directories(${target} PRIVATE "${S5_AUDIO_CPP_DIR}")
  target_link_libraries(${target} PRIVATE s5_audio_core libohaudio.so)
endfunction()
