import { pasteboard } from '@kit.BasicServicesKit';
import { util } from '@kit.ArkTS';
import { audioConfigure, audioStatus, audioStop } from 'libs3c.so';
import { RemoteFiles, FilesCommand } from './RemoteFiles';
import { DisplayState, displayStatus, displayErrorText } from './DisplayModel';
export interface ClipboardEvent {action:string;text?:string;version?:number;}
interface AudioConfig {enabled:boolean;muted:boolean;volume:number;paused:boolean;background:boolean;}
export interface AdvancedCommand {op:string;event?:Object;}
interface ScreenSelection {action:string;id:number;confirmed:boolean;}
interface ClipReply {error?:string;listening?:boolean;incomingAvailable?:boolean;incomingBytes?:number;incomingVersion?:number;version?:number;text?:string;sent?:boolean;sentMessages?:number;totalMessages?:number;remoteAck?:boolean|null;deduplicated?:boolean;}
interface AudioReply {lastError?:number;decodedPackets?:number;plcPackets?:number;queuedPackets?:number;rendererAllocated?:boolean;accepting?:boolean;error?:string;enabled?:boolean;volume?:number;muted?:boolean;state?:string;rendererState?:number;actualAudibility?:boolean|null;}
export class AdvancedView {controls:DisplayState|undefined=undefined;screenText:string='等待电脑报告显示器信息';screenBusy:boolean=false;clipText:string='手动同步：未读取系统剪贴板';clipDraftBytes:number=0;clipHasDraft:boolean=false;audioText:string='本地音频未启用';audioEnabled:boolean=false;audioMuted:boolean=false;volume:number=0.8;}
export class AdvancedClient {
 view:AdvancedView=new AdvancedView();files:RemoteFiles;private notify:((v:AdvancedView)=>void)|undefined=undefined;private send:(c:AdvancedCommand)=>Promise<string>;private foreground:boolean=true;private run:number=0;private draft:string|undefined=undefined;private appliedVersion:number=0;
 constructor(send:(c:AdvancedCommand)=>Promise<string>){this.send=send;this.files=new RemoteFiles((c:FilesCommand)=>{const command:AdvancedCommand={op:c.op,event:c.event};return send(command);});}
 observe(fn:((v:AdvancedView)=>void)|undefined):void{this.notify=fn;this.show();}
 private show():void {if(this.notify){const v=new AdvancedView();v.controls=this.view.controls;v.screenText=this.view.screenText;v.screenBusy=this.view.screenBusy;v.clipText=this.view.clipText;v.clipDraftBytes=this.view.clipDraftBytes;v.clipHasDraft=this.view.clipHasDraft;v.audioText=this.view.audioText;v.audioEnabled=this.view.audioEnabled;v.audioMuted=this.view.audioMuted;v.volume=this.view.volume;this.notify(v);}}
 async switchScreen(id:number):Promise<void>{if(this.view.screenBusy||!this.foreground){return;}const run=this.run;this.view.screenBusy=true;this.view.screenText='正在发送切屏请求';this.show();try{const event:ScreenSelection={action:'switch_screen',id:id,confirmed:true};const command:AdvancedCommand={op:'peer_advanced',event:event};const result=JSON.parse(await this.send(command)) as DisplayState;if(run!==this.run){return;}if(result.error){this.view.screenText=displayErrorText(result.error);}else{this.view.controls=result;this.view.screenText=displayStatus(result);}}catch(_){this.view.screenText='切屏接口暂不可用，请重试。';}finally{if(run===this.run){this.view.screenBusy=false;this.show();}}}
 private async call(event:ClipboardEvent,op:string='peer_clipboard'):Promise<string>{if(!this.foreground){throw Error('foreground_required');}return this.send({op:op,event:event});}
 // Called only by the system-authorized PasteButton SUCCESS callback.
 async captureLocalClipboard():Promise<void>{const run=this.run;try{const data=await pasteboard.getSystemPasteboard().getData();if(run!==this.run||!this.foreground){return;}if(!data.hasType(pasteboard.MIMETYPE_TEXT_PLAIN)){throw Error('text_required');}const text=data.getPrimaryText();const bytes=new util.TextEncoder().encodeInto(text).length;if(bytes>30*1024||text.includes('\u0000')){throw Error('text_over_limit');}this.draft=text;this.view.clipDraftBytes=bytes;this.view.clipHasDraft=true;this.view.clipText=`已在本地读取${bytes}字节；确认后才发送到Windows。`;}
  catch(_){this.draft=undefined;this.view.clipHasDraft=false;this.view.clipText='未读取：系统未授权、剪贴板不是纯文本或超过30KiB。';}this.show();}
 async sendLocalClipboard():Promise<void>{if(this.draft===undefined){return;}const run=this.run;const text=this.draft;this.draft=undefined;this.view.clipHasDraft=false;try{const r=JSON.parse(await this.call({action:'send',text:text})) as ClipReply;if(run!==this.run){return;}this.view.clipText=r.deduplicated?'已忽略重复或来自远端的相同文字':r.sent?`鸿蒙→Windows：已发送${r.sentMessages}/${r.totalMessages}，远端应用尚未确认`:'未完成发送：'+(r.error||'未知');}catch(_){this.view.clipText='剪贴板发送未完成；会话不可用';}this.show();}
 async listenClipboard():Promise<void>{try{const r=JSON.parse(await this.call({action:'listen'})) as ClipReply;this.view.clipText=r.error?'接收未开启：'+r.error:'已开启60秒接收窗口；请在Windows复制文字，再点“获取远端文本”。不会自动写系统剪贴板。';}catch(_){this.view.clipText='接收未开启：会话不可用';}this.show();}
 async applyRemoteClipboard():Promise<void>{const run=this.run;try{const r=JSON.parse(await this.call({action:'peek'})) as ClipReply;if(run!==this.run||!this.foreground){return;}if(r.error||r.text===undefined||r.version===undefined){this.view.clipText='尚无远端文本；先开启接收窗口并在Windows复制。';this.show();return;}if(this.appliedVersion===r.version){this.view.clipText='已忽略重复版本';this.show();return;}const bytes=new util.TextEncoder().encodeInto(r.text).length;if(bytes>30*1024||r.text.includes('\u0000')){throw Error('text_limit');}await pasteboard.getSystemPasteboard().setData(pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN,r.text));if(run!==this.run||!this.foreground){return;}const ack=JSON.parse(await this.call({action:'applied',version:r.version})) as ClipReply;if(ack.error){throw Error('stale_clipboard');}this.appliedVersion=r.version;this.view.clipText=`Windows→鸿蒙：已收到并写入本机系统剪贴板${bytes}字节；内容不记录。`;}
  catch(_){this.view.clipText='远端文本未应用：无授权、过期版本或会话变化。';}this.show();}
 async disableClipboard():Promise<void>{this.draft=undefined;this.view.clipHasDraft=false;try{await this.call({action:'disable'});}catch(_){}this.view.clipText='手动同步已关闭，缓存已清除';this.show();}
 private audioSummary(raw:string):string {const r=JSON.parse(raw) as AudioReply;if(r.error||r.lastError||r.state==='error'){return '本地音频出错'+(r.error?'：'+r.error:r.lastError?'（'+r.lastError+'）':'');}if(r.state==='focus_paused'){return '本地播放已暂停';}if(r.state==='focus_stopped'){return '本地播放已停止';}if(r.enabled===false){return '本地音频未启用';}if(r.muted){return '本地音频已静音';}if(r.state==='starting'){return '正在启动本地播放';}if(r.state==='running'){return (r.decodedPackets||0)>0?'本地播放器运行中':'等待远端声音';}return '等待本地音频状态';}
 configureAudio(enabled:boolean,muted:boolean,volume:number):void{this.view.audioEnabled=enabled;this.view.audioMuted=muted;this.view.volume=volume;try{const config:AudioConfig={enabled:enabled,muted:muted,volume:volume,paused:false,background:!this.foreground};this.view.audioText=this.audioSummary(audioConfigure(JSON.stringify(config)));}catch(_){this.view.audioText='本地音频接口不可用';}this.show();}
 async refresh():Promise<void>{const run=this.run;if(!this.foreground){return;}try{const r=JSON.parse(await this.call({action:'status'},'peer_advanced')) as DisplayState;if(run!==this.run){return;}if(!r.error){this.view.controls=r;if(!this.view.screenBusy){this.view.screenText=displayStatus(r);}}const clip=JSON.parse(await this.call({action:'status'})) as ClipReply;if(clip.incomingAvailable){this.view.clipText=`已接收远端文本${clip.incomingBytes||0}字节；等待你写入本机剪贴板。`;}}catch(_){}try{this.view.audioText=this.audioSummary(audioStatus());}catch(_){}this.show();}
 setForeground(value:boolean):void{this.foreground=value;this.files.setForeground(value);if(!value){this.run++;this.view.screenBusy=false;this.draft=undefined;this.view.clipHasDraft=false;this.files.disconnect();try{audioStop();}catch(_){}this.view.audioEnabled=false;this.view.audioText='后台已释放本地音频';this.show();}}
 disconnect():void{this.run++;this.draft=undefined;this.appliedVersion=0;this.files.disconnect();try{audioStop();}catch(_){}this.view=new AdvancedView();this.show();}
 dispose():void{this.disconnect();this.files.dispose();this.notify=undefined;}
}
